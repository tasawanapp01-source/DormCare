rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // System configuration and metadata
    match /systemConfig/{docId} {
      allow read, write: if true;
    }

    // Users collection - Direct database read, create, update, delete
    match /users/{userId} {
      allow read, write: if true;
    }

    // Properties collection
    match /properties/{propertyId} {
      allow read, write: if true;
    }

    // Repair Categories collection
    match /repairCategories/{categoryId} {
      allow read, write: if true;
    }

    // Work Orders collection and subcollections
    match /workOrders/{ticketId} {
      allow read, write: if true;

      // Subcollection: events (Work order history timeline)
      match /events/{eventId} {
        allow read, write: if true;
      }
    }

    // Inventory items
    match /inventoryItems/{itemId} {
      allow read, write: if true;
    }

    // Inventory transactions (Audit Trail)
    match /inventoryTransactions/{txId} {
      allow read, write: if true;
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Default match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
